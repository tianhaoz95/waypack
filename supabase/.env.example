SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=local-placeholder
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=com.hejitech.waypack.web,com.hejitech.waypack
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=local-placeholder
