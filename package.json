{
  "name": "waypack",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "workspaces": [
    "packages/*",
    "services/mcp"
  ],
  "scripts": {
    "build": "npm run build -w @waypack/bundle-schema -w @waypack/trip-sdk -w @waypack/cli",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "feedbackkit-web": "^1.0.62"
  },
  "devDependencies": {
    "mermaid": "^11.17.2",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17"
  }
}
