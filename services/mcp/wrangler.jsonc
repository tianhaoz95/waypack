{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "waypack-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // One deployment serves the landing page + account portal (site/), the app API and MCP.
  "assets": {
    "directory": "../../site",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/mcp", "/mcp/*", "/api/*", "/authorize", "/token", "/register", "/.well-known/*", "/upload/*", "/files/*", "/stripe/*", "/healthz"]
  },

  // Production custom domains (uncomment when deploying). Site, portal, API and MCP share one origin.
  // "routes": [{ "pattern": "waypack.app", "custom_domain": true }],

  "vars": {
    "PUBLIC_URL": "http://127.0.0.1:8787",
    "SUPABASE_URL": "http://127.0.0.1:55421",
    // Planet the tiler extracts from. Production: the monthly R2 mirror (see services/tiler).
    "PLANET_URL": "latest",
    "BASEMAP_MAX_ZOOM": "15",
    // Leave TILER_URL empty to use the Cloudflare Container binding; set it to call a tiler over HTTP (local docker).
    "TILER_URL": "http://127.0.0.1:8090",
    // Optional online basemap for free-tier users / previews (TileJSON or .pmtiles URL). Empty = none.
    "ONLINE_TILES_URL": "",
    "ENVIRONMENT": "development"
  },

  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "REPLACE_WITH_KV_ID" },
    { "binding": "CACHE_KV", "id": "REPLACE_WITH_KV_ID_2" }
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "waypack" },
    // Public bucket (custom domain = BASEMAP_PUBLIC_URL) for the monthly planet mirror.
    { "binding": "BASEMAP", "bucket_name": "waypack-basemap" }
  ],
  "queues": {
    "producers": [{ "binding": "TILE_QUEUE", "queue": "waypack-tiles" }],
    "consumers": [{ "queue": "waypack-tiles", "max_batch_size": 1, "max_retries": 3, "dead_letter_queue": "waypack-tiles-dlq" }]
  },
  "containers": [
    { "class_name": "TilerContainer", "image": "../tiler/Dockerfile", "instance_type": "standard-2", "max_instances": 3 }
  ],
  "durable_objects": { "bindings": [{ "name": "TILER", "class_name": "TilerContainer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TilerContainer"] }],
  "triggers": {
    // 03:17 UTC daily: expire map extracts 30 days after end_date, clean stale uploads.
    // 04:00 UTC on the 2nd: refresh the basemap planet mirror.
    "crons": ["17 3 * * *", "0 4 2 * *"]
  }
}
